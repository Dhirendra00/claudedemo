# Neon Postgres connection string (use the pooled connection from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public app URL (used by the auth client in the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
